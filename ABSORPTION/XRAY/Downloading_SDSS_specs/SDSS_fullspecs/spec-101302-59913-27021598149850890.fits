ed spField            TFORM4  = 'J       '                                                            TTYPE5  = 'CATALOGID'          / SDSS-V CatalogID used in naming                TFORM5  = 'K       '                                                            TTYPE6  = 'SDSS_ID '           / Unified SDSS Target Indentifier                TFORM6  = 'K       '                                                            TTYPE7  = 'FIBERID_LIST'       / List of FiberIDs contributing to Stack         TFORM7  = '27A     '                                                            TTYPE8  = 'RUN2D   '           / Spectro-2D reduction name                      TFORM8  = '6A      '                                                            TTYPE9  = 'RUN1D   '           / Spectro-1D reduction name                      TFORM9  = '6A      '                                                            TTYPE10 = 'OBJTYPE '           / Why this object was targetted. QSO=SCIENCE     TFORM10 = '16A     '                                                            TTYPE11 = 'FIBER_RA'           / Fiber RA [J2000 for plate; at exp for FPS]     TFORM11 = 'D       '                                                            TTYPE12 = 'FIBER_DEC'          / Fiber DEC [J2000 for plate; at exp for FPS]    TFORM12 = 'D       '                                                            TTYPE13 = 'PLUG_RA '           / Object RA (drilled fiber position) [J2000]     TFORM13 = 'D       '                                                            TTYPE14 = 'PLUG_DEC'           / Object DEC (drilled fiber position) [J2000]    TFORM14 = 'D       '                                                            TTYPE15 = 'CLASS   '           / Spectro classification: GALAXY, QSO, STAR      TFORM15 = '6A      '                                                            TTYPE16 = 'SUBCLASS'           / Spectro sub-classification                     TFORM16 = '19A     '                                      